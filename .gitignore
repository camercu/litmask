# Build artifacts
/target/
**/target/

# Cargo.lock is tracked (workspace contains a binary)

# direnv / Nix
/.direnv/
/.envrc.local

# Editor / IDE
*.swp
*.swo
*~
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Node (commitlint, semantic-release)
/node_modules/

# LLVM profiling data (cargo-llvm-cov)
*.profraw
*.profdata

# Fuzzing output (cargo-fuzz). Every `just fuzz` run writes newly
# discovered inputs into the corpus and any reproducer into artifacts/.
# Both directories hold only generated files: the tracked seed corpus
# lives in fuzz/seeds/, which no rule here matches. Hiding the generated
# ones keeps them out of `git status` and away from `typos`, which skips
# ignored paths and would otherwise trip `just ci` on their gibberish
# contents.
/litmask/fuzz/corpus/
/litmask/fuzz/artifacts/

# Mutation testing output (cargo-mutants)
/mutants.out/
/mutants.out.old/

# Claude Code local config
/.claude/
.harden/
